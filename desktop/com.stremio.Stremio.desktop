[Desktop Entry]
Version=1.0
Name=Stremio
Comment=Stream Movies, TV Series & Live Channels
Icon=com.stremio.Stremio
Categories=AudioVideo;Video;Player;TV;
Keywords=Stremio;Media;Play;
Type=Application
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=stremio --file-forwarding com.stremio.Stremio @@u %u @@
MimeType=x-scheme-handler/stremio;
Terminal=false
StartupNotify=true
X-Flatpak=com.stremio.Stremio
