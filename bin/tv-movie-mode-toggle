#!/usr/bin/env python3
"""Toggle display between Movie Mode (4K) and UI Mode (1080p) with Bigscreen UI feedback."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from typing import Any


TV_DISPLAY_MODE = os.path.expanduser("~/.local/bin/tv-display-mode")
if not os.path.exists(TV_DISPLAY_MODE):
    TV_DISPLAY_MODE = shutil.which("tv-display-mode") or TV_DISPLAY_MODE
ICON_NAME = "video-television"


def toggle_display_mode() -> dict[str, Any]:
    proc = subprocess.run(
        [TV_DISPLAY_MODE, "toggle", "--json"],
        capture_output=True,
        text=True,
        check=True,
        timeout=15,
    )
    return json.loads(proc.stdout)


def _format_hz(refresh_rate: Any) -> str:
    if refresh_rate is None or refresh_rate == "":
        return ""
    try:
        hz = float(refresh_rate)
    except (TypeError, ValueError):
        return ""
    if hz <= 0:
        return ""
    if abs(hz - round(hz)) < 0.05:
        return f"{int(round(hz))}Hz"
    return f"{hz:.2f}Hz"


def _extract_mode_details(result: dict[str, Any]) -> tuple[str, str, str]:
    """Return (dimensions_text, hz_text, short_res_label) from applied/display payload."""
    applied = result.get("applied") or {}
    disp = result.get("display") or {}

    size = applied.get("size") or disp.get("size")
    refresh_rate = applied.get("refresh_rate")
    if refresh_rate is None:
        refresh_rate = disp.get("refresh_rate")
    mode_name = str(applied.get("mode_name") or disp.get("current_mode_name") or "").strip()

    width = 0
    height = 0
    if isinstance(size, dict):
        try:
            width = int(size.get("width") or 0)
            height = int(size.get("height") or 0)
        except (TypeError, ValueError):
            width, height = 0, 0

    dim = f"{width}x{height}" if (width > 0 and height > 0) else ""
    hz = _format_hz(refresh_rate)

    # Parse fallback dimensions/Hz from mode_name like "3840x2160@60" if structured fields omitted
    if (not dim or not hz) and "@" in mode_name:
        part_dim, part_hz = mode_name.split("@", 1)
        if not dim and "x" in part_dim:
            dim = part_dim.strip()
        if not hz:
            hz = _format_hz(part_hz.strip().rstrip("Hzhz"))

    if width >= 3840 or height >= 2160:
        short_label = "4K"
    elif height > 0:
        short_label = f"{height}p"
    else:
        short_label = ""

    return dim, hz, short_label


def format_feedback(result: dict[str, Any]) -> tuple[str, str, str]:
    dec = result.get("decision") or {}
    disp = result.get("display") or {}
    applied = result.get("applied") or {}

    output = str(
        applied.get("output")
        or disp.get("output")
        or "Display"
    )
    requested_target = str(dec.get("target") or result.get("manual_mode") or "1080p")
    resolved_target = str(applied.get("resolved_target") or requested_target)
    dec_reason = str(dec.get("reason") or "")
    applied_reason = str(applied.get("reason") or "")
    is_fallback = bool(applied.get("fallback", False))

    dim, hz, short_label = _extract_mode_details(result)

    if applied_reason == "display_unavailable" or (disp.get("error") and not applied.get("mode_id")):
        err = str(applied.get("error") or disp.get("error") or "display unavailable")
        return (
            "Display Unavailable",
            "Display Unavailable",
            f"{output}: {err}",
        )

    if dec_reason == "steam_priority":
        mode_desc = f"{dim} @ {hz}" if (dim and hz) else (dim or "1920x1080 @ 60Hz")
        label = short_label or "1080p"
        return (
            f"{label} Mode (Steam Priority)",
            f"{label} Mode (Steam Priority)",
            f"{output} stays at {mode_desc} while Steam is active",
        )

    if is_fallback and requested_target == "4k" and resolved_target != "4k":
        mode_desc = f"{dim} @ {hz}" if (dim and hz) else (dim or "1920x1080 @ 60Hz")
        label = short_label or "1080p"
        return (
            f"{label} Mode (4K Unavailable)",
            "4K Mode Unavailable",
            f"{output} stays at {mode_desc} (4K mode not advertised)",
        )

    if resolved_target == "4k":
        mode_desc = f"{dim} @ {hz}" if (dim and hz) else (dim or "3840x2160")
        osd = f"Movie Mode: 4K @ {hz}" if hz else "Movie Mode: 4K"
        return (
            osd,
            "Movie Mode",
            f"{output} switched to {mode_desc}",
        )

    label = short_label or "1080p"
    mode_desc = f"{dim} @ {hz}" if (dim and hz) else (dim or "1920x1080 @ 60Hz")
    osd = f"{label} Mode: {label} @ {hz}" if hz else f"{label} Mode"
    return (
        osd,
        f"{label} Mode",
        f"{output} switched to {mode_desc}",
    )


def show_plasma_osd(text: str) -> None:
    try:
        import dbus

        bus = dbus.SessionBus()
        obj = bus.get_object("org.kde.plasmashell", "/org/kde/osdService")
        iface = dbus.Interface(obj, "org.kde.osdService")
        iface.showText(ICON_NAME, text)
    except Exception:
        pass


def show_brief_banner(title: str, subtitle: str, duration_ms: int = 1600) -> None:
    """
    Open and auto-close a brief Wayland window so Plasma Bigscreen's
    StartupFeedbackWindow receives active=false and dismisses immediately.
    """
    try:
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gdk, GLib, Gtk

        css = Gtk.CssProvider()
        css.load_from_data(
            b"""
            window.tv-toast {
                background-color: rgba(20, 24, 31, 0.96);
                border: 2px solid rgba(110, 175, 255, 0.75);
                border-radius: 14px;
            }
            label.tv-title {
                color: #ffffff;
                font-size: 24px;
                font-weight: bold;
            }
            label.tv-subtitle {
                color: #c8d2e0;
                font-size: 16px;
            }
            """
        )
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        win = Gtk.Window(title=title)
        win.get_style_context().add_class("tv-toast")
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_position(Gtk.WindowPosition.CENTER)
        win.set_keep_above(True)
        win.set_border_width(24)

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        icon = Gtk.Image.new_from_icon_name(ICON_NAME, Gtk.IconSize.DIALOG)
        box.pack_start(icon, False, False, 0)

        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        lbl_title = Gtk.Label(label=title, xalign=0.0)
        lbl_title.get_style_context().add_class("tv-title")
        lbl_sub = Gtk.Label(label=subtitle, xalign=0.0)
        lbl_sub.get_style_context().add_class("tv-subtitle")
        text_box.pack_start(lbl_title, False, False, 0)
        text_box.pack_start(lbl_sub, False, False, 0)
        box.pack_start(text_box, True, True, 0)

        win.add(box)
        win.connect("destroy", Gtk.main_quit)
        win.connect("key-press-event", lambda *_: Gtk.main_quit())
        win.connect("button-press-event", lambda *_: Gtk.main_quit())
        GLib.timeout_add(duration_ms, Gtk.main_quit)
        win.show_all()
        win.present()
        Gtk.main()
    except Exception:
        pass


def main() -> int:
    no_gui = "--no-gui" in sys.argv[1:]
    res = toggle_display_mode()
    osd_text, title, subtitle = format_feedback(res)
    print(f"{title}: {subtitle}")
    show_plasma_osd(osd_text)
    if not no_gui:
        show_brief_banner(title, subtitle)
    return 0


if __name__ == "__main__":
    sys.exit(main())
